      <category>local</category>
      <source url="https://spotmedia.ro/stiri/mediu/control-al-garzii-de-mediu-dupa-ce-fumul-si-mirosul-de-cauciucuri-arse-au-invadat-centrul-capitalei-video-diana-buzoianu-tu-ai-respira-acest-aer">Spotmedia</source>
