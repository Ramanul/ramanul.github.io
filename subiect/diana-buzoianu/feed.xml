      <category>politic</category>
      <source url="https://observatornews.ro/eveniment/sefa-anm-reactie-dupa-dezvaluirile-dianei-buzoianu-legate-de-cumparaturile-de-lux-din-bani-publici-668666.html">Observator</source>
